# Copy to .env.local (gitignored) for local runs; set the same names in Vercel for deploys.
# Every variable is optional: the app runs without any of them, with the feature
# it powers switched off or falling back as noted. See docs/RUNBOOK.md.

# --- Security keys (set both in production) ---
# Signs officer role sessions. Without it each server instance makes its own
# random secret, and the browser renews its session when another instance answers.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SAMIKSHA_SESSION_SECRET=
# AES-256-GCM key for stored classroom proof photos: 32 bytes in base64, or any
# passphrase (hashed to 32 bytes). Without it, a production server checks photos
# but stores none; a development machine keeps its own key in .samiksha-media-key.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SAMIKSHA_MEDIA_KEY=
# The previous media key, kept only while proofs are re-encrypted after a rotation.
SAMIKSHA_MEDIA_KEY_PREV=

# --- Database (Postgres; without it an in-memory database is used) ---
DATABASE_URL=

# --- Telegram field channel (without it, cards stay in the in-app action register) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BEO_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
SAMIKSHA_RUN_SECRET=
CRON_SECRET=

# --- AI co-pilot (without them, the verified code ranking and rule reading are used) ---
ANTHROPIC_API_KEY=
XAI_API_KEY=

# --- Speech-to-text for voice notes (without them, officers type or use browser speech) ---
SARVAM_API_KEY=
BHASHINI_API_KEY=
BHASHINI_INFERENCE_URL=
BHASHINI_ASR_SERVICE_ID=
OPENAI_API_KEY=

# --- WhatsApp (optional second channel; sends only once Meta approves the templates) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- Laya second-check sidecar (optional; rule scores are used without it) ---
LAYA_URL=
LAYA_MODEL=
